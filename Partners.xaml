<Page x:Class="WpfApp1.Partners"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Partners"
      Background="White">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="Resources/Images/Мастер пол.png" Width="100" Height="100"/>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="PartnersList" Margin="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0 0 0 10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock>
                                        <Run Text="{Binding TypePartner}"/>
                                        <Run Text="|"/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Director}" Margin="0 5 0 0"/>
                                    <TextBlock Text="{Binding Phone}" Margin="0 5 0 0"/>
                                    <TextBlock>
                                        <Run Text="Рейтинг: "/>
                                         <Run Text="{Binding Rating}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
            Text="{Binding DiscountInf}"
            FontSize="16"
            Margin="10 0 0 0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Page>
